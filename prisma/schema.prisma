generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyType {
  startup
  enterprise
  agency
  non_profit
}

enum UserStatus {
  active
  invited
  suspended
}

enum JobStatus {
  draft
  open
  paused
  closed
}

enum HiringPriority {
  high
  medium
  low
}

enum CandidateStatus {
  new
  screening
  interview
  offer
  rejected
  hired
}

enum PipelineStage {
  applied
  screening
  technical_interview
  hr_interview
  offer
  hired
  rejected
}

enum NotificationChannel {
  email
  sms
  in_app
}

enum TenantStatus {
  active
  suspended
  pending
}

enum AuditActionType {
  create
  update
  delete
  login
  logout
  evaluate
  ai_evaluate
  send_message
  suspend
  activate
}

enum CompanyRegistrationStatus {
  pending
  approved
  rejected
}

model Company {
  id                     String      @id @default(uuid())
  companyName            String
  companyAddress         Json
  industry               String
  companySize            String
  companyType            CompanyType
  foundedYear            Int
  companyWebsite         String
  officialCompanyAddress String
  phoneNumber            String?
  companyLogo            String
  shortDescription       String
  linkedinUrl            String?
  twitterUrl             String?
  termsAccepted          Boolean
  tenant                 Tenant?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
}

model Tenant {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  companyId   String?      @unique
  company     Company?     @relation(fields: [companyId], references: [id])
  status      TenantStatus @default(active)
  users       User[]
  inviteTokens InviteToken[]
  passwordResetTokens PasswordResetToken[]
  roles       Role[]
  permissions Permission[]
  userRoles   UserRole[]
  sessions    Session[]
  jobs        Job[]
  candidates  Candidate[]
  pipelines   Pipeline[]
  evaluations Evaluation[]
  notifications Notification[]
  messages    Message[]
  metrics     Metric[]
  auditLogs   AuditLog[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model SuperAdmin {
  id           String              @id @default(uuid())
  email        String              @unique
  passwordHash String
  firstName    String
  lastName     String
  sessions     SuperAdminSession[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model SuperAdminSession {
  id               String     @id @default(uuid())
  superAdminId     String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  superAdmin       SuperAdmin @relation(fields: [superAdminId], references: [id])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model User {
  id           String     @id @default(uuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  firstName    String
  lastName     String
  email        String
  passwordHash String
  otpRequired  Boolean    @default(false)
  loginOtpHash String?
  loginOtpExpiresAt DateTime?
  status       UserStatus @default(active)
  userRoles    UserRole[]
  sessions     Session[]
  inviteTokens InviteToken[]
  passwordResetTokens PasswordResetToken[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([tenantId, email])
}

model InviteToken {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Role {
  id              String           @id @default(uuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  name            String
  description     String?
  rolePermissions RolePermission[]
  userRoles       UserRole[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([tenantId, name])
}

model Permission {
  id              String           @id @default(uuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  key             String
  description     String?
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([tenantId, key])
}

model RolePermission {
  id           String     @id @default(uuid())
  tenantId     String
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([tenantId, roleId, permissionId])
}

model UserRole {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())

  @@unique([tenantId, userId, roleId])
}

model Session {
  id               String    @id @default(uuid())
  tenantId         String
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  user             User      @relation(fields: [userId], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Job {
  id              String      @id @default(uuid())
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  title           String
  description     String
  location        String?
  employmentType  String?
  status          JobStatus   @default(draft)
  openings        Int         @default(1)
  department         String?
  experienceMin      Int?
  experienceMax      Int?
  skillWeights       Json?
  requirements       String?
  niceToHave         String?
  screeningQuestions String[] @default([])
  hiringPriority     HiringPriority?
  applications    Pipeline[]
  evaluations     Evaluation[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Candidate {
  id               String           @id @default(uuid())
  tenantId         String
  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  firstName        String
  lastName         String
  email            String
  passwordHash     String?
  emailVerified    Boolean          @default(false)
  lastLoginAt      DateTime?
  phoneNumber      String?
  resumeUrl        String?
  resumeMimeType   String?
  linkedinUrl      String?
  portfolioUrl     String?
  expectedSalary   Float?
  noticePeriod     Int?
  skills           String[]         @default([])
  location         String?
  source           String?
  currentCompany   String?
  yearsOfExperience Float?
  status           CandidateStatus  @default(new)
  applications     Pipeline[]
  evaluations      Evaluation[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([tenantId, email])
}

model Pipeline {
  id            String        @id @default(uuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  jobId         String
  job           Job           @relation(fields: [jobId], references: [id])
  candidateId   String
  candidate     Candidate     @relation(fields: [candidateId], references: [id])
  stage         PipelineStage @default(applied)
  assignedTo    String?
  slaDeadline   DateTime?
  decisionNote  String?
  notes         String?
  evaluations   Evaluation[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([tenantId, jobId, candidateId])
}

model Evaluation {
  id             String    @id @default(uuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  jobId          String
  job            Job       @relation(fields: [jobId], references: [id])
  candidateId    String
  candidate      Candidate @relation(fields: [candidateId], references: [id])
  pipelineId     String?
  pipeline       Pipeline? @relation(fields: [pipelineId], references: [id])
  score          Float
  summary        String?
  whyCard        String?
  aiGenerated    Boolean   @default(false)
  rankingSummary String?
  roleFitNotes   String?
  sectionScores  Json?
  skillMatches   Json?
  parsedResumeData Json?
  evaluatedBy    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Notification {
  id          String              @id @default(uuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  channel     NotificationChannel
  type        String
  title       String
  body        String
  recipient   String
  status      String              @default("queued")
  sentAt      DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model Message {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  type        String
  subject     String
  body        String
  recipient   String
  status      String   @default("queued")
  direction   String   @default("outbound")
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Metric {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  value       Float
  dimension   String?
  recordedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id          String          @id @default(uuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  actorId     String?
  action      AuditActionType
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime        @default(now())
}

model CompanyRegistrationRequest {
  id                     String                    @id @default(uuid())
  companyName            String
  companyAddress         Json
  industry               String
  companySize            String
  companyType            CompanyType
  foundedYear            Int
  companyWebsite         String
  officialCompanyAddress String
  phoneNumber            String?
  companyLogo            String
  shortDescription       String
  linkedinUrl            String?
  twitterUrl             String?
  termsAccepted          Boolean
  contactName            String
  contactEmail           String
  status                 CompanyRegistrationStatus @default(pending)
  reviewedBy             String?
  reviewNotes            String?
  approvedTenantId       String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
}
