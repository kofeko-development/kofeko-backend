# ─────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────
# REQUIRED (all envs)
PORT=3000

# OPTIONAL (defaults to development)
NODE_ENV=development               # development | production | test

# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
# REQUIRED (all envs)
DATABASE_URL=                      # Supabase Transaction Pooler URI (for app runtime)
                                   # postgresql://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# REQUIRED (all envs)
DIRECT_URL=                        # Supabase Direct Connection URI (for prisma migrate only)
                                   # postgresql://postgres:[pass]@db.[ref].supabase.co:5432/postgres

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
# REQUIRED (all envs)
JWT_SECRET=                        # strong random string, min 32 chars

# OPTIONAL (defaults shown)
JWT_ACCESS_EXPIRES_IN=15m          # access token lifetime
JWT_REFRESH_EXPIRES_IN=7d          # refresh token lifetime

# ─────────────────────────────────────────────
# EMAIL — local MailHog OR Resend OR SMTP
# ─────────────────────────────────────────────
# If RESEND_API_KEY is set (non-empty), the backend sends via Resend and ignores SMTP.
# For local dev with MailHog: leave RESEND_* empty and point SMTP_* at MailHog (below).
# In tests (NODE_ENV=test), email sending is a no-op.
#
# --- Local catcher (MailHog-compatible: Mailpit recommended on macOS Homebrew) ---
# brew install mailpit && mailpit   → UI http://localhost:8025  |  SMTP [::]:1025 (connect via 127.0.0.1:1025)
# Or Docker: docker run -p 1025:1025 -p 8025:8025 mailhog/mailhog
# SMTP_USER / SMTP_PASS can be any string — MailHog does not validate them.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=mailhog
SMTP_PASS=mailhog
SMTP_FROM="Kofeko Dev <noreply@mailhog.local>"
#
# --- Resend (production / hosted; disable MailHog SMTP above when using this) ---
# RESEND_API_KEY=re_xxxx
# RESEND_FROM="Kofeko <noreply@your-verified-domain.com>"
RESEND_API_KEY=
RESEND_FROM=
#
# --- Generic SMTP (e.g. Gmail) — only when not using Resend and not MailHog ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password

# OPTIONAL (used only if SMTP_FROM is blank)
SMTP_FROM_NAME=Kofeko
SMTP_FROM_EMAIL=no-reply@kofeko.com

# ─────────────────────────────────────────────
# FILE STORAGE
# ─────────────────────────────────────────────
# OPTIONAL (defaults to local)
STORAGE_PROVIDER=local             # local | supabase | firebase
                                   # 'local' for dev without Supabase, 'supabase' for staging/prod
                                   # LinkedIn share images are stored here; use supabase in prod for stable public URLs

# REQUIRED only when STORAGE_PROVIDER=supabase
SUPABASE_URL=                      # https://[ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=         # service_role JWT key (NOT anon key) from Settings → API
SUPABASE_STORAGE_BUCKET=resumes    # must match bucket name created in dashboard

# REQUIRED only when STORAGE_PROVIDER=firebase
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=              # paste full key including -----BEGIN/END----- lines, in quotes
FIREBASE_CLIENT_EMAIL=
FIREBASE_STORAGE_BUCKET=           # e.g. your-project.appspot.com

# ─────────────────────────────────────────────
# AI — evaluation, resume parse, JD creator
# ─────────────────────────────────────────────
# Provider order (see src/common/ai/jsonCompletion.ts):
#   1. Replicate when REPLICATE_API_TOKEN is set (preferred for local + production)
#   2. OpenRouter when OPEN_ROUTE is set (fallback if Replicate unset)

# REQUIRED (production) — at least one of REPLICATE_API_TOKEN or OPEN_ROUTE
REPLICATE_API_TOKEN=               # https://replicate.com/account/api-tokens

# OPTIONAL (defaults shown)
REPLICATE_MODEL=openai/gpt-5.2     # model to use for evaluation
REPLICATE_REASONING_EFFORT=low     # none | low | medium | high | xhigh
REPLICATE_VERBOSITY=low            # low | medium | high
REPLICATE_MAX_COMPLETION_TOKENS=16384

# OPTIONAL — OpenRouter fallback (used only when REPLICATE_API_TOKEN is empty)
OPEN_ROUTE=                        # https://openrouter.ai/keys

# ─────────────────────────────────────────────
# SUPER ADMIN
# ─────────────────────────────────────────────
# REQUIRED (production)
SUPER_ADMIN_SETUP_KEY=             # strong random string — used to bootstrap super admin

# Legacy (still supported via defaults in env schema)
# OPTIONAL (defaults shown; not required by production validation)
SUPERADMIN_USERNAME=superadmin@123
SUPERADMIN_PASSWORD=kofeko_123

# ─────────────────────────────────────────────
# LINKEDIN INTEGRATION (Tier 3 auto-post; Tier 1+2 need none)
# LinkedIn Developer Portal: "Share on LinkedIn" + "Sign In with LinkedIn (OpenID Connect)"
# Default connect uses personal posting only (w_member_social). Company page needs extra approval.
# ─────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/v1/linkedin/callback
LINKEDIN_ENCRYPT_KEY=              # random 32+ char string for encrypting stored OAuth tokens
LINKEDIN_REQUEST_ORG_SCOPES=false    # true after LinkedIn approves Marketing API: w_organization_social + rw_organization_admin

# ─────────────────────────────────────────────
# FRONTEND
# ─────────────────────────────────────────────
# REQUIRED (production)
APP_FRONTEND_URL=http://localhost:3001   # used in invite/reset email links

# ─────────────────────────────────────────────
# DEVELOPMENT ONLY
# ─────────────────────────────────────────────
# OPTIONAL (defaults to false unless explicitly set elsewhere)
SWAGGER_ENABLED=true               # enable Swagger UI at /api/v1/docs

# ─────────────────────────────────────────────
# OPTIONAL / LEGACY / TESTING
# ─────────────────────────────────────────────
# OPTIONAL override (defaults to APP_FRONTEND_URL)
FRONTEND_URL=

# Legacy overrides (if set, take precedence over JWT_SECRET)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Seed bootstrap (optional)
SEED_BOOTSTRAP_ENABLED=true
SEED_TENANT_NAME="Demo Tenant"
SEED_TENANT_SLUG="demo-tenant"
SEED_ADMIN_FIRST_NAME="Platform"
SEED_ADMIN_LAST_NAME="Admin"
SEED_ADMIN_EMAIL="admin@demo.com"
SEED_ADMIN_PASSWORD="Admin@12345"

# Candidate tenant defaults (internal auth module)
# OPTIONAL (defaults shown)
CANDIDATE_TENANT_SLUG="kofeko-candidates"
CANDIDATE_TENANT_NAME="Kofeko Candidates"

# Tests (guard)
# REQUIRED for tests unless ALLOW_DATABASE_URL_FOR_TESTS=true
DATABASE_URL_TEST=
ALLOW_DATABASE_URL_FOR_TESTS=false


OPEN_ROUTE=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