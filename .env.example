NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kofeko_dev?schema=public"
JWT_ACCESS_SECRET="change-this-access-secret"
JWT_REFRESH_SECRET="change-this-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
FRONTEND_URL="http://localhost:3000"

SUPERADMIN_USERNAME="superadmin@123"
SUPERADMIN_PASSWORD="kofeko_123"

# SMTP config for approval emails
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="Kofeko"
SMTP_FROM_EMAIL="no-reply@kofeko.com"

# Seed bootstrap (optional)
SEED_BOOTSTRAP_ENABLED="true"
SEED_TENANT_NAME="Demo Tenant"
SEED_TENANT_SLUG="demo-tenant"
SEED_ADMIN_FIRST_NAME="Platform"
SEED_ADMIN_LAST_NAME="Admin"
