NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kofeko_dev?schema=public"
JWT_ACCESS_SECRET="change-this-access-secret"
JWT_REFRESH_SECRET="change-this-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend
APP_FRONTEND_URL="http://localhost:3000"

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="noreply@kofeko.ai"

# Seed bootstrap (optional)
SEED_BOOTSTRAP_ENABLED="true"
SEED_TENANT_NAME="Demo Tenant"
SEED_TENANT_SLUG="demo-tenant"
SEED_ADMIN_FIRST_NAME="Platform"
SEED_ADMIN_LAST_NAME="Admin"
SEED_ADMIN_EMAIL="admin@demo.com"
SEED_ADMIN_PASSWORD="Admin@12345"
