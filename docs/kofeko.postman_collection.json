            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantName\": \"Acme\",\n  \"tenantSlug\": \"acme\",\n  \"firstName\": \"Admin\",\n  \"lastName\": \"User\",\n  \"email\": \"admin@acme.com\",\n  \"password\": \"AdminA1aaaa\"\n}"
